{
  "functions": {
    "source": "firebase/functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase/**",
      "node_modules/**",
      ".git/**",
      ".codex/**",
      ".freebuff/**",
      "tools/**",
      "src/**",
      "*.md",
      "_*.html",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "server.js",
      ".env.example"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
