{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "../",
    "ignore": [
      "firebase/**",
      "node_modules/**",
      ".git/**",
      ".codex/**",
      ".freebuff/**",
      "README.md",
      "tools/**",
      "*.md",
      "_*.html"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
